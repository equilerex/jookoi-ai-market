{
  "//": "Merge into ~/.claude/settings.json (every repo; the hooks stay silent in repos without items.yaml) or a repo's .claude/settings.json. Do not replace the file. No SubagentStop: subagents do not own the working set.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/doc-gate.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/preserve.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/rehydrate.sh\""
          }
        ]
      }
    ]
  }
}
