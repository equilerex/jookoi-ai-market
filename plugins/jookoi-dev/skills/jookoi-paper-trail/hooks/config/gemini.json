{
  "//": "Merge into .gemini/hooks/hooks.json. Requires Gemini CLI v0.26.0+.",
  "hooks": {
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/preserve.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/preserve.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compress|startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/rehydrate.sh\""
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/jookoi-paper-trail/hooks/nudge.sh\""
          }
        ]
      }
    ]
  },
  "//nudge": "AfterAgent runs nudge.sh, at most once per session. If an older merge added an AfterAgent entry running doc-gate.sh, replace it with this one."
}
